# Absolute-URL base for canonicals and Open Graph images.
#
# UNSET (the default) means https://schulersrestaurant.com, which is what you
# want the day this launches on their own domain.
#
# WHILE THIS IS A PITCH, set it to the pitch host, or every og:image resolves to
# a domain that does not serve this build and the link preview comes back blank:
#
#   NEXT_PUBLIC_SITE_ORIGIN=https://schulers.glazedweb.com
#
# Delete it on launch day.
NEXT_PUBLIC_SITE_ORIGIN=

# Nothing else. No API keys, no mail service, no database. The forms on this
# build do not send: see the PLACEHOLDER list in the README.
